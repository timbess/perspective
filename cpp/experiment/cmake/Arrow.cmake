
ExternalProject_Add(Arrow
  GIT_REPOSITORY git@github.com:apache/arrow.git
  GIT_TAG apache-arrow-19.0.0
  SOURCE_SUBDIR cpp
  CMAKE_ARGS -DARROW_SIMD_LEVEL=NONE -DBUILD_TESTING=OFF -DARROW_WITH_LZ4=ON -DARROW_BUILD_SHARED=OFF -DARROW_MIMALLOC=OFF -DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE} -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} -DARROW_ENABLE_THREADING=OFF
)
ExternalProject_Get_Property(Arrow SOURCE_DIR)
ExternalProject_Get_Property(Arrow BINARY_DIR)

set(ARROW_SOURCE_DIR ${SOURCE_DIR})
set(ARROW_BINARY_DIR ${BINARY_DIR})